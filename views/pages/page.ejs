<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css" rel="stylesheet">
    <title>Blog</title>
    <style>

        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap');
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                background: #f8f9fb;
                color: #111827;
                line-height: 1.7;
            }

            .header {
                height: 3.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 7%;
                background: rgba(255, 255, 255, .9);
                border-bottom: 1px solid #e5e7eb;
                position: sticky;
                top: 0;
                z-index: 20;
                backdrop-filter: blur(15px);
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 9px;
                font-size: 16px;
                font-weight: 800;
                letter-spacing: .08em;
            }

            .login-btn {
                border: none;
                background: transparent;
                color: #111827;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
            }

            /* ARTICLE */
            main {
                max-width: 760px;
                margin: auto;
                padding: 70px 20px 100px;
            }

            .article {
                position: relative;
            }

            .category {
                display: inline-block;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: .12em;
                color: #6366f1;
                margin-bottom: 20px;
            }

            h1 {
                font-size: clamp(36px, 6vw, 58px);
                line-height: 1.08;
                letter-spacing: -0.045em;
                margin-bottom: 22px;
            }

            .subtitle {
                font-size: 19px;
                color: #6b7280;
                margin-bottom: 30px;
            }

            /* AUTHOR & STORIES ANEL */
            .author {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }


.avatar img{
    width: 42px;
    height: 42px;

    border-radius: 50%;

    background: #e0e7ff;

    display: grid;
    place-items: center;

    color: #4f46e5;

    font-weight: 800;
}


            .author strong,
            .author span {
                display: block;
            }

            .author strong {
                font-size: 14px;
            }

            .author span {
                font-size: 12px;
                color: #9ca3af;
            }

            .content {
                font-size: 18px;
            }

            .content p {
                margin-bottom: 24px;
            }

            .blurred-content {
                position: relative;
                max-height: 240px;
                overflow: hidden;
                margin-top: 20px;
            }

            .blurred-content::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                bottom: 0;
                height: 180px;
                background: linear-gradient(to bottom, rgba(248, 249, 251, 0), #f8f9fb);
            }

            /* Paywall */
            .paywall {
                position: relative;
                margin-top: -30px;
                padding: 45px 35px 35px;
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 24px;
                box-shadow: 0 25px 70px rgba(17, 24, 39, .10);
                text-align: center;
                overflow: hidden;
                z-index: 5;
            }

            .paywall-glow {
                position: absolute;
                width: 300px;
                height: 300px;
                top: -180px;
                left: 50%;
                transform: translateX(-50%);
                background: #6366f1;
                opacity: .08;
                filter: blur(70px);
                border-radius: 50%;
            }

            .lock {
                width: 52px;
                height: 52px;
                margin: auto auto 18px;
                border-radius: 15px;
                background: #f3f4f6;
                display: grid;
                place-items: center;
                font-size: 21px;
            }

            .premium-label {
                font-size: 11px;
                letter-spacing: .13em;
                font-weight: 800;
                color: #6366f1;
            }

            .paywall h2 {
                margin-top: 10px;
                font-size: 29px;
                letter-spacing: -.025em;
            }

            .paywall-description {
                max-width: 500px;
                margin: 10px auto 25px;
                color: #6b7280;
                font-size: 15px;
            }

            .benefits {
                display: grid;
                gap: 10px;
                text-align: left;
                max-width: 410px;
                margin: 0 auto 25px;
            }

            .benefit {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .benefit span {
                width: 22px;
                height: 22px;
                display: grid;
                place-items: center;
                border-radius: 50%;
                background: #ecfdf5;
                color: #059669;
                font-size: 12px;
                font-weight: 800;
            }

            .benefit p {
                font-size: 14px;
            }

            .pricing {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 15px;
                margin: 25px 0;
            }

            .price {
                text-align: left;
            }

            .price small {
                display: block;
                color: #9ca3af;
                font-size: 11px;
            }

            .price strong {
                font-size: 30px;
                letter-spacing: -.04em;
            }

            .price span {
                color: #6b7280;
                font-size: 13px;
            }

            .trial {
                background: #fef3c7;
                color: #92400e;
                padding: 7px 10px;
                border-radius: 8px;
                font-size: 11px;
                font-weight: 800;
            }

            .cta {
                width: 100%;
                max-width: 430px;
                border: none;
                padding: 17px 20px;
                border-radius: 12px;
                background: #111827;
                color: white;
                font-size: 15px;
                font-weight: 700;
                cursor: pointer;
                transition: .2s;
            }

            .cta:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 25px rgba(17, 24, 39, .20);
            }

            .trust {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                margin-top: 22px;
            }

            .avatars {
                display: flex;
            }

            .avatars span {
                width: 28px;
                height: 28px;
                margin-left: -5px;
                display: grid;
                place-items: center;
                border: 2px solid white;
                border-radius: 50%;
                background: #e5e7eb;
                font-size: 9px;
                font-weight: 800;
            }

            .avatars span:first-child {
                margin-left: 0;
            }

            .avatars img {
                width: 28px;
                height: 28px;
                margin-left: -5px;
                display: grid;
                place-items: center;
                border: 2px solid white;
                border-radius: 50%;
                background: #e5e7eb;
                font-size: 9px;
                font-weight: 800;
            }

            .avatars img:first-child {
                margin-left: 0;
            }

            .trust strong,
            .trust small {
                display: block;
                text-align: left;
            }

            .trust strong {
                font-size: 11px;
            }

            .trust small {
                color: #9ca3af;
                font-size: 10px;
            }

            .secure {
                margin-top: 18px;
                color: #9ca3af;
                font-size: 10px;
            }
   .faq {
        margin-top: 60px;
    }

    .faq h3 {
        margin-bottom: 20px;
        font-size: 20px;
        font-weight: 700;
        color: #111827;
    }

    .faq-item {
        padding: 20px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .faq-item:first-of-type {
        border-top: 1px solid #e5e7eb;
    }

    .faq-item h4 {
        margin: 0 0 10px;
        font-size: 15px;
        font-weight: 600;
        line-height: 1.5;
        color: #111827;
    }

    .faq-answer {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.7;
    }

            .site-footer {
                max-width: 760px;
                margin: auto;
                padding: 70px 20px 100px;
                color: #6b7280;
                font-size: 13px;
            }

            .footer-container {
                max-width: 1100px;
                margin: 0 auto;
            }

            .footer-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 30px;
                margin-bottom: 30px;
                text-align: left;
            }

            .footer-brand {
                font-weight: 700;
                font-size: 16px;
                color: #111827;
                display: block;
            }

            .footer-title {
                font-weight: 600;
                color: #374151;
                display: block;
                margin-bottom: 12px;
            }

            .footer-col ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .footer-col li {
                margin-bottom: 8px;
            }

            .footer-col a {
                color: #6b7280;
                text-decoration: none;
                transition: color 0.2s;
            }

            .footer-col a:hover {
                color: #6366f1;
            }

            .footer-desc {
                padding-top: 10px;
            }

            .footer-desc,
            .footer-info {
                margin: 0 0 6px;
                line-height: 1.4;
            }

            .footer-bottom {
                text-align: center;
                color: #9ca3af;
                font-size: 12px;
            }

            footer {
                text-align: center;
                color: #9ca3af;
                font-size: 12px;
            }

            @media (max-width: 700px) {
                .container,
                .narrow {
                    width: min(100% - 28px, 850px);
                }

                .topbar .container {
                    flex-direction: column;
                    gap: 4px;
                }

                .hero {
                    padding-top: 20px;
                }

                .hero h1 {
                    font-size: 39px;
                    letter-spacing: -1px;
                }

                .subtitle {
                    font-size: 18px;
                }

                .image-placeholder {
                    height: 280px;
                }

                .article p {
                    font-size: 18px;
                }

                .article h2 {
                    font-size: 29px;
                    margin-top: 50px;
                }

                .lead {
                    font-size: 22px !important;
                }

                .highlight {
                    padding: 22px;
                    font-size: 20px;
                }

                blockquote {
                    font-size: 22px;
                    padding: 25px 15px;
                }

                .mechanism {
                    margin-left: -7px;
                    margin-right: -7px;
                    padding: 30px 20px;
                }

                .steps {
                    grid-template-columns: 1fr;
                    gap: 10px;
                }

                .offer {
                    margin-left: -7px;
                    margin-right: -7px;
                    padding: 40px 20px;
                }

                .product-box {
                    grid-template-columns: 1fr;
                    gap: 25px;
                }

                .product-cover {
                    width: 210px;
                    margin: auto;
                }

                .final-cta {
                    padding: 40px 20px;
                }

                .final-cta h2 {
                    font-size: 29px;
                }

                footer .container {
                    flex-direction: column;
                }
            }

            @media (max-width: 640px) {
                .footer-grid,
                .footer-bottom {
                    text-align: left;
                }
            }

            @media (max-width: 600px) {
                .header {
                    padding: 0 20px;
                }

                main {
                    padding-top: 45px;
                }

                h1 {
                    font-size: 38px;
                }

                .subtitle {
                    font-size: 17px;
                }

                .paywall {
                    padding: 35px 20px 25px;
                    border-radius: 20px;
                }

                .paywall h2 {
                    font-size: 25px;
                }

                .pricing {
                    flex-direction: column;
                }
                
                .price {
                    text-align: center;
                }
            }
        
